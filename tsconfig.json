{
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"]
}
